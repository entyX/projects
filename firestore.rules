rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    // private profile + full history
    match /users/{uid} { allow read, write: if me(uid); }
    // public leaderboard row
    match /leaders/{uid} {
      allow read: if true;
      allow write: if me(uid) && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
    }
    // unique usernames
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && name.size() <= 20;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // one daily score per player, write-once
    match /dailies/{n}/scores/{uid} {
      allow read: if true;
      allow create: if me(uid) && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 500;
    }
  }
}
